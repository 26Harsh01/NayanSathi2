# GEMINI_API_KEY: Required for server-side Gemini AI sentence completion (/api/gemini/suggest).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Optional Supabase Configuration (App runs in Local Demo Mode if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Python FastAPI Backend URL (Used when deploying backend separately)
VITE_BACKEND_API_URL=
ALLOWED_ORIGINS=http://localhost:3000

# Optional Smart Home Bridge (Home Assistant REST API - server-side only)
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional Stockfish Engine Endpoint for Chess Computer Opponent
STOCKFISH_ENDPOINT_URL=

